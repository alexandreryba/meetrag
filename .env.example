# Copy to .env at the project root (next to pyproject.toml) and fill in. Every setting is
# documented in src/meetrag/config.py; provider keys such as ANTHROPIC_API_KEY are exported
# to the process environment at startup.

# --- Option 1: Claude API (default) ----------------------------------------------------------
ANTHROPIC_API_KEY=
MEETRAG_LLM_PROVIDER=anthropic
MEETRAG_LLM_MODEL=claude-opus-5-5
# Router, graders, SQL agent and verifier. A smaller model cuts cost, e.g. claude-haiku-5-5.
MEETRAG_LLM_FAST_MODEL=claude-opus-5-5
MEETRAG_JUDGE_MODEL=claude-opus-5-5

# --- Option 2: Claude on Google Cloud Vertex AI (uses Application Default Credentials) -------
# MEETRAG_LLM_PROVIDER=anthropic-vertex
# MEETRAG_GCP_PROJECT=my-project
# MEETRAG_GCP_REGION=global

# --- Option 3: any LangChain chat model (uv sync --extra langchain + the provider package) ---
# MEETRAG_LLM_PROVIDER=langchain
# MEETRAG_LLM_MODEL=google_genai:gemini-2.5-flash
# MEETRAG_LLM_FAST_MODEL=google_genai:gemini-2.5-flash
# MEETRAG_JUDGE_MODEL=google_genai:gemini-2.5-flash
# GOOGLE_API_KEY=

# --- Option 4: your Claude Pro/Max subscription, local use only (uv sync --extra subscription)
# Uses the Claude Code login of this machine; no API key needed.
# MEETRAG_LLM_PROVIDER=claude-code

# --- Meeting transcripts ----------------------------------------------------------------------
# Emails and phone numbers are masked before indexing (set to false to keep them).
# MEETRAG_REDACT_PII=true

# --- Retrieval --------------------------------------------------------------------------------
# MEETRAG_RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# MEETRAG_QDRANT_URL=http://localhost:6333

# --- API ---------------------------------------------------------------------------------------
# Require an X-API-Key header on /v1/* endpoints
# MEETRAG_API_KEY=change-me
